      "grass": "#10a96b",
      "petrol": "#2da4b6",
      "light-blue": "#6cc5dd",
      "bg": "#0a1428",
      "surface": "#11203c",
      "surface-elevated": "#182d52",
      "surface-overlay": "rgba(0, 0, 0, 0.55)",
      "text-primary": "#f1f5f9",
      "text-secondary": "#b0b9c7",
      "text-tertiary": "#6f7b8e",
      "text-disabled": "#475569",
      "text-on-primary": "#ffffff",
      "text-on-cta": "#ffffff",
      "border": "#1e3559",
      "border-strong": "#2d4675",
      "border-focus": "var(--lumo-primary)",
      "success": "#10a96b",
      "success-subtle": "#0f3a2a",
      "warning": "#e09b30",
      "warning-subtle": "#3d2e15",
      "danger": "#c44848",
      "danger-subtle": "#3a1c1c",
      "info": "#2da4b6",
