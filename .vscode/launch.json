{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch API",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build:api",
      "program": "${workspaceFolder}/src/mVasu.Api/bin/Debug/net10.0/mVasu.Api.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/mVasu.Api",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/scalar/v1"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "sourceFileMap": {
        "/Views": "${workspaceFolder}/Views"
      }
    },
    {
      "name": "Launch PWA (Chrome)",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "watch:pwa",
      "url": "https://localhost:4200",
      "webRoot": "${workspaceFolder}/src/mVasu.Pwa",
      "sourceMaps": true,
      "userDataDir": "${workspaceFolder}/.vscode/.chrome-debug-profile"
    }
  ],
  "compounds": [
    {
      "name": "Launch Full Stack",
      "configurations": ["Launch API", "Launch PWA (Chrome)"],
      "stopAll": true
    }
  ]
}
